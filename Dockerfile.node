#
# 节点 agent 镜像（cmd/node）。
# 纯 Go 静态编译 (CGO_ENABLED=0)，运行时为极简 alpine 镜像。
FROM golang:1.26-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -trimpath -ldflags="-s -w" -o /out/librespeed-node ./cmd/node

FROM alpine:3.20

RUN apk add --no-cache wget ca-certificates \
    && addgroup -g 10001 nodeagent \
    && adduser -D -H -u 10001 -G nodeagent -s /sbin/nologin nodeagent \
    && mkdir -p /data \
    && chown -R nodeagent:nodeagent /data

COPY --from=builder /out/librespeed-node /usr/local/bin/librespeed-node
COPY docker/node-healthcheck.sh /usr/local/bin/node-healthcheck.sh
RUN chmod +x /usr/local/bin/node-healthcheck.sh

ENV NODE_HOST=0.0.0.0 \
    NODE_PORT=8081 \
    NODE_NAME=node \
    NODE_PROTOCOL=http \
    NODE_INI=/data/node.ini \
    NODE_REGISTER_RETRIES=10

USER nodeagent

VOLUME ["/data"]

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD /usr/local/bin/node-healthcheck.sh || exit 1

CMD ["/usr/local/bin/librespeed-node"]
