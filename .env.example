# 复制为 .env 并修改。所有令牌都不要提交到版本库。
#
# 生成一个安全令牌:
#   openssl rand -base64 32

# 管理 API（节点增删改查 / 触发测速）所需令牌，长度至少 16。
ADMIN_TOKEN=change-me-admin-please-generate-a-strong-random-token

# 节点注册 API 所需令牌，长度至少 16，且不能与 ADMIN_TOKEN 相同。
REGISTRATION_TOKEN=change-me-registration-please-generate-a-strong-random-token

# 用于加密封存节点 node_key（使中心服务能主动发起健康检查/测速）的主密钥。
# 仅当 STORE_NODE_KEY_SEALED=true 时必须设置，长度至少 16。
SECRET_KEY=change-me-secret-please-generate-a-strong-random-key

# ---- 服务 ----
HOST=127.0.0.1
PORT=8080
# 本地（非 Docker）运行时相对仓库根目录下的 data/ 目录；docker-compose 会在
# web 服务里把它覆盖成 sqlite:///data/librespeed.db，指向挂载的 /data volume，
# 这里的值不需要跟着改。
DATABASE_URL=sqlite:./data/librespeed.db
LOG_LEVEL=info

# ---- 节点访问 / SSRF 控制 ----
# 开发环境下默认为 true，允许注册/访问内网节点（自建测速节点是主要场景）。
# 生产环境如果不需要访问内网节点，请设置为 false，
# 拒绝回环 / 私网 / 链路本地(含 169.254.169.254 云元数据) / 保留 / 多播地址。
ALLOW_PRIVATE_NODES=true
ALLOWED_NODE_PROTOCOLS=http,https
NODE_CONNECT_TIMEOUT=5.0
NODE_REQUEST_TIMEOUT=30.0
NODE_HEALTH_TIMEOUT=5.0

# ---- 测速参数 ----
MAX_TEST_BYTES=536870912
DEFAULT_DOWNLOAD_BYTES=33554432
DEFAULT_UPLOAD_BYTES=16777216
STREAM_CHUNK_BYTES=65536
PING_COUNT=6

# ---- 节点 key 存储策略 ----
# true : 中心额外保存一份用 SECRET_KEY 加密封存的 node_key 副本，
#        可以自动做健康检查 / 主动发起测速。
# false: 数据库中只有 sha256 哈希，管理员每次健康检查/测速都要在请求体里
#        手动提供 node_key。
STORE_NODE_KEY_SEALED=true

# ---- 仅供 docker-compose 使用 ----
# WEB_PORT：宿主机映射到中心服务容器 8080 端口的端口号（可选，默认 8080）。
WEB_PORT=8080

# ---- 节点自动注册（推荐，docker compose up -d 后 node 容器自己完成） ----
# node 容器启动 HTTP 服务前，会用下面这些变量调用 web 服务的
# POST /api/register/auto 完成注册，并把拿到的凭据原子写入容器内的
# NODE_INI（compose 默认挂载到 node-data volume，重启/重建容器不会丢）。
# 不再需要手动 curl 或复制 node_key。
#
# NODE_REGISTER_URL：注册地址，只允许 http/https。同一 compose 网络内默认
#   已经指向 web 服务，一般不需要改。
NODE_REGISTER_URL=http://web:8080/api/register/auto
# REGISTRATION_TOKEN 复用上面已定义的同名变量，无需重复设置。
# NODE_ADDRESS：中心服务据此访问该节点的地址（compose 网络内用服务名 node）。
NODE_ADDRESS=node
# NODE_PORT：节点 agent 端口号快捷配置（可选，默认 8081）。
# 若需要分别配置本地监听端口与外部测速端口（如端口映射/NAT/反代场景），可使用：
#   NODE_LISTEN_PORT=8081      # 本地 HTTP 服务绑定监听的端口
#   NODE_ADVERTISE_PORT=18081  # 注册并向中心公布的外部测速端口
NODE_PORT=8081
# NODE_LISTEN_PORT=8081
# NODE_ADVERTISE_PORT=8081
# NODE_NAME：节点 agent 的显示名称（可选，默认 node-1）。
NODE_NAME=node-1
NODE_PROTOCOL=http
# NODE_METADATA_JSON：可选，注册时附带的任意 JSON 元数据，例如 {"region":"cn-east"}。
NODE_METADATA_JSON=
# NODE_INI：node.ini 持久化文件路径（容器内默认 /data/node.ini，已挂载卷）。
NODE_INI=/data/node.ini
# 网络暂时不可用时的最大重试次数（指数退避 1/2/4/8/16...秒）。
NODE_REGISTER_RETRIES=10

# NODE_KEY：显式高级覆盖，留空（默认）即可。非空时 node 容器会跳过自动注册，
#   直接用这个 key 启动——只有需要手动固定 key 时才填，不要把真实密钥提交到仓库。
NODE_KEY=
