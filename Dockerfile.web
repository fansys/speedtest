#
# 中心 Web 服务镜像（cmd/web）。
# 基于纯 Go 标准库与官方标准 SQLite 引擎 (modernc.org/sqlite)，CGO_ENABLED=0 静态编译。
FROM golang:1.26-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -trimpath -ldflags="-s -w" -o /out/librespeed-web ./cmd/web

FROM alpine:3.20

RUN apk add --no-cache wget ca-certificates \
    && addgroup -g 10001 webapp \
    && adduser -D -H -u 10001 -G webapp -s /sbin/nologin webapp \
    && mkdir -p /data /app/static \
    && chown -R webapp:webapp /data /app

WORKDIR /app
COPY --from=builder /out/librespeed-web /usr/local/bin/librespeed-web
COPY --chown=webapp:webapp static ./static

ENV HOST=0.0.0.0 \
    PORT=8080 \
    DATABASE_URL=sqlite:///data/librespeed.db

USER webapp

VOLUME ["/data"]

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --spider -q http://127.0.0.1:8080/healthz || exit 1

CMD ["/usr/local/bin/librespeed-web"]
